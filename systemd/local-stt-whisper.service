[Unit]
Description=local-stt: whisper.cpp inference server (loopback only)
Documentation=file://%h/projects/local-stt/docs/06-stt-engine.md
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/local-stt/whisper-server.env
ExecStart=%h/.local/share/local-stt/bin/whisper-server $LOCAL_STT_WHISPER_ARGS
Restart=on-failure
RestartSec=2
Nice=5
MemoryMax=2G
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
LimitCORE=0

[Install]
WantedBy=graphical-session.target
